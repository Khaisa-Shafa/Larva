<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/linearBottomSheet"
    android:background="@drawable/dialog_clasify_bkg"
    android:padding="16dp">

    <ImageView
        android:id="@+id/swipe_dialog"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_remove"
        android:scaleType="centerCrop"
        android:layout_gravity="center|top"
        app:tint="@color/custom_color_black"/>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Choose Model"
            android:textSize="25sp"
            android:textColor="@color/custom_color_text_primary"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"/>

        <ImageView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            app:tint="@color/custom_color_black"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutUploadImageDetection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_marginTop="10dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_detection"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOLOv8 + MobileNetv3"
            android:textColor="@color/custom_color_text_primary"
            android:layout_marginStart="30dp"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLiveDetection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="30dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_detection"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOLO11-Seg + MobileViT"
            android:textColor="@color/custom_color_text_primary"
            android:layout_marginStart="30dp"
            android:textSize="16sp"/>
    </LinearLayout>


</LinearLayout>